{
  "name": "@drop-the-tabs/shared-api",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./pairing": {
      "types": "./dist/pairing/index.d.ts",
      "default": "./dist/pairing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@drop-the-tabs/shared-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
