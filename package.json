{
  "name": "drop-the-tabs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:extension": "turbo run dev --filter=@drop-the-tabs/extension",
    "dev:mobile": "turbo run dev --filter=@drop-the-tabs/mobile",
    "dev:server": "turbo run dev --filter=@drop-the-tabs/sync-server",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .output",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "postinstall": "bunx patch-package"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  }
}
